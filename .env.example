# Copy this file to `.env` and edit values for your machine.
# `.env` is gitignored — never commit personal paths.

# ---------- Chrome session ----------
# Path to a Chrome user-data directory. Use a dedicated bot profile so it
# doesn't conflict with your real browser. The included run.bat creates one
# at %USERPROFILE%\ChromeBot the first time it runs.
CHROME_USER_DATA_DIR=C:\Users\YourName\ChromeBot
CHROME_PROFILE_DIR=Profile 2

# ---------- Server ----------
PORT=4545
NODE_ENV=development

# ---------- Pacing & limits ----------
# Random delay between IG actions, in milliseconds. Bigger = safer.
# Recommended for follows: 20000–45000.  For unfollows: 8000–20000.
MIN_DELAY_MS=15000
MAX_DELAY_MS=30000

# Hard cap on follow + unfollow actions per day. Keep low to avoid IG flags.
# Recommended: 50–80 for follows, 100–150 for unfollows.
DAILY_LIMIT=80

# Test mode — log what would happen without performing actions.
DRY_RUN=false

# ---------- HTTP / CORS ----------
# Same-origin in single-folder mode (UI served from this backend).
# If you proxy from a different domain, set explicit origins.
CORS_ORIGIN=*

# ---------- Logging ----------
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- Selenium internals ----------
PAGE_LOAD_TIMEOUT_MS=45000
ELEMENT_TIMEOUT_MS=15000
IG_BASE_URL=https://www.instagram.com

# ---------- Remote debugging ----------
# When true, the backend attaches to an already-running Chrome on the port
# below (run.bat launches Chrome with --remote-debugging-port). Recommended
# for local dev — lets you reuse a logged-in session and watch jobs run.
USE_REMOTE_DEBUGGING=true
REMOTE_DEBUGGING_PORT=9222
