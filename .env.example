# Copy this file to `.env` and edit values for your machine.
# `.env` is gitignored — never commit personal paths.

# ---------- Chrome session ----------
# Path to a Chrome user-data directory. Use a dedicated bot profile so it
# doesn't conflict with your real browser. The included run.bat creates one
# at %USERPROFILE%\ChromeBot the first time it runs.
CHROME_USER_DATA_DIR=C:\Users\YourName\ChromeBot
CHROME_PROFILE_DIR=Profile 2

# ---------- Server ----------
PORT=4545
NODE_ENV=development

# ---------- Pacing & limits ----------
# Random delay between IG actions, in milliseconds. Bigger = safer.
# Recommended for follows: 20000–45000.  For unfollows: 8000–20000.
MIN_DELAY_MS=15000
MAX_DELAY_MS=30000

# Hard cap on follow + unfollow actions per day. Keep low to avoid IG flags.
# Recommended: 50–80 for follows, 100–150 for unfollows.
DAILY_LIMIT=80

# Test mode — log what would happen without performing actions.
DRY_RUN=false

# ---------- HTTP / CORS ----------
# Same-origin in single-folder mode (UI served from this backend).
# If you proxy from a different domain, set explicit origins.
CORS_ORIGIN=*

# ---------- Logging ----------
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- Selenium internals ----------
PAGE_LOAD_TIMEOUT_MS=45000
ELEMENT_TIMEOUT_MS=15000
IG_BASE_URL=https://www.instagram.com

# ---------- Remote debugging ----------
# When true, the backend attaches to an already-running Chrome on the port
# below (run.bat launches Chrome with --remote-debugging-port). Recommended
# for local dev — lets you reuse a logged-in session and watch jobs run.
USE_REMOTE_DEBUGGING=true
REMOTE_DEBUGGING_PORT=9222

# ---------- Auto-import (Instagram data download ZIPs) ----------
# Folder watched for new IG "Download your information" ZIPs. Typically the
# local folder where Google Drive desktop client syncs to. When a new .zip
# appears, the importer extracts followers_*.json + following.json from
# connections/followers_and_following/ inside it and writes the snapshot.
# Leave blank to disable. Example (Windows):
#   IG_IMPORT_DIR=C:\Users\YourName\Google Drive\IG Exports
# Example (Drive mounted as G:):
#   IG_IMPORT_DIR=G:\My Drive\IG Exports
IG_IMPORT_DIR=

# IG username the imported data belongs to. Used as a fallback if the ZIP
# doesn't contain personal_information.json. Most ZIPs have it, but setting
# this avoids any chance of an "owner unknown" error.
IG_IMPORT_OWNER=

# How often to scan the import folder for new ZIPs (milliseconds).
IG_IMPORT_POLL_MS=30000

# ---------- Apify (followers/following without the browser) ----------
# Uses the apify/instagram-followers-following-scraper Actor to fetch your
# followers + following lists — no Selenium, no load on your IG session.
# Token: https://console.apify.com/settings/integrations
# Comma-separate several tokens to fall back when one is rejected (auth/credit).
# NOTE: on Apify's FREE plan the Actor returns only the first page of each
# list. A full scan needs a paid plan (billed per result, from $1.15/1,000).
APIFY_TOKENS=

# Auto-scan every N hours (fractions OK, e.g. 24 or 168). 0 / blank = manual only.
# Each scan bills (followers + following) results, so weigh frequency vs cost.
APIFY_SCAN_INTERVAL_HOURS=0

# Max results per list per run (cost ceiling). If a list hits this cap the
# result is treated as incomplete and held back.
APIFY_RESULTS_LIMIT=10000

# Optional hard spend cap per Actor run, in USD. Blank = no cap.
APIFY_MAX_CHARGE_USD=

# Hold back (don't save) a result if followers or following shrank by more than
# this % vs the last snapshot — protects the unfollow list from truncated scans.
APIFY_MAX_SHRINK_PCT=25
